{
  "name": "qa-api-supertest",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js API test framework using Supertest, Jest, Express, and consumer contract verification.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:contract": "jest src/contracts --runInBand",
    "test:api": "jest src/tests --runInBand",
    "check": "node --check src/app.js && node --check src/server.js && node --check src/config.js"
  },
  "license": "MIT",
  "dependencies": {
    "@pact-foundation/pact": "^17.1.2",
    "axios": "^1.6.7",
    "express": "^5.2.1",
    "supertest": "^7.2.2"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.0.1"
  }
}
